apiVersion: v1
kind: Service
metadata:
  name: keycloak
  namespace: {{ iam_namespace }}
  labels:
    app: keycloak
spec:
  selector:
    app: keycloak
  ports:
    - protocol: TCP
      port: {{ keycloak_service_port }}
      targetPort: 8080
      nodePort: {{ keycloak_nodeport }}
      name: http
  type: NodePort
