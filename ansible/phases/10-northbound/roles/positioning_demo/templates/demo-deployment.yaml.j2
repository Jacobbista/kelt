apiVersion: apps/v1
kind: Deployment
metadata:
  name: location-app
  namespace: {{ demo_namespace }}
  labels:
    app: location-app
    kelt.io/role: app
  annotations:
    kelt.io/subtitle: "consumer demo"
    kelt.io/description: "3D asset-location view"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: location-app
  template:
    metadata:
      labels:
        app: location-app
      annotations:
        checksum/wiring: "{{ (lookup('template', role_path + '/templates/location-app-wiring.yaml.j2') ~ lookup('template', role_path + '/templates/demo-nginx-configmap.yaml.j2')) | hash('sha256') }}"
    spec:
      nodeSelector:
        kubernetes.io/hostname: worker
      terminationGracePeriodSeconds: 10
      containers:
        - name: location-app
          image: {{ location_app_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 80
              name: http
              protocol: TCP
          # Browser config as pod env; the image entrypoint renders env-config.js
          # from it. optional so a degraded pod still boots and serves /contract.
          # Order matters: a later source wins, so the operator ConfigMap overrides
          # the wiring. location-app-wiring is rewritten by this role;
          # location-app-config is written by the dashboard Configure form.
          envFrom:
            - configMapRef:
                name: location-app-wiring
                optional: true
            - configMapRef:
                name: location-app-config
                optional: true
          readinessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 5
            periodSeconds: 5
            failureThreshold: 6
          # Only the nginx config is mounted (legit deployment routing). env-config.js
          # is NOT mounted: the entrypoint owns it (mounting it RO shadows the render).
          volumeMounts:
            - name: demo-nginx
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
      volumes:
        - name: demo-nginx
          configMap:
            name: location-app-nginx
