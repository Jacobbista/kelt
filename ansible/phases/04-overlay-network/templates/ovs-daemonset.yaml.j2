apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: ds-net-setup-{{ node_type }}
  namespace: kube-system
spec:
  selector:
    matchLabels:
      app: ds-net-setup-{{ node_type }}
  template:
    metadata:
      labels:
        app: ds-net-setup-{{ node_type }}
      annotations:
        # Forza il rollout quando cambia uno degli script
        scripts-hash: >-
          {{ (
               lookup('file', playbook_dir + '/scripts/ovs-setup.sh') +
               lookup('file', playbook_dir + '/scripts/ovs-gc.sh') +
               lookup('file', playbook_dir + '/scripts/plane-metrics.sh') +
               lookup('file', playbook_dir + '/scripts/host-networkd-prepare.sh')
             ) | hash('sha256') }}
    spec:
      hostNetwork: true
      hostPID: true
      nodeSelector:
        kubernetes.io/hostname: "{{ node_type }}"
      tolerations:
      - operator: "Exists"
      volumes:
      - name: host-ovs-run              # OVS runtime
        hostPath: { path: /var/run/openvswitch }
      - name: host-ovs-etc              # OVS DB/etc
        hostPath: { path: /etc/openvswitch }
      - name: host-systemd-network      # <-- necessario per scrivere la .link sull'host
        hostPath: { path: /etc/systemd/network }
      - name: ovs-scripts
        configMap:
          name: ovs-scripts
      - name: node-metrics             # node-exporter textfile collector dir
        hostPath: { path: "{{ node_exporter_textfile_dir }}", type: DirectoryOrCreate }
      containers:
      - name: setup
        image: {{ alpine_image }}
        securityContext:
          privileged: true
        env:
        - name: NODE_NAME
          valueFrom: { fieldRef: { fieldPath: spec.nodeName } }
        - name: WORKER_IP
          value: "{{ hostvars[groups['workers'][0]]['ansible_host'] }}"
        - name: EDGE_IP
          value: "{{ hostvars[groups['edges'][0]]['ansible_host'] if (groups.get('edges', []) | length > 0) else '' }}"
        - name: EDGE_ENABLED
          value: "{{ edge_enabled | default(false) | bool | lower }}"
        - name: CELL_COUNT
          value: "{{ cell_count | default('0') }}"
        # Physical RAN bridging (for femtocell integration)
        - name: RAN_INTERFACE
          value: "{{ ran_interface | default('') }}"
        - name: RAN_BRIDGE_MODE
          value: "{{ ran_bridge_mode | default('disabled') }}"
        - name: RAN_SUBNET
          value: "{{ physical_ran_subnet | default('') }}"
        - name: RAN_GATEWAY_CIDR
          value: "{{ physical_ran_gateway }}/{{ physical_ran_subnet.split('/')[1] }}"
        # Plane isolation filter on the worker, see docs/architecture/plane-isolation.md
        - name: PLANE_FILTER_MODE
          value: "{{ plane_filter_mode }}"
        - name: PLANE_UE_POOLS
          value: "{{ ue_internet_subnet }}, {{ ue_mec_subnet }}"
        - name: PLANE_METRICS_DIR
          value: /node-metrics
        - name: PLANE_METRICS_INTERVAL
          value: "{{ plane_metrics_interval }}"
        - name: OVERLAY_MTU
          value: "{{ overlay_mtu }}"
        - name: N6_DATA_MTU
          value: "{{ n6_data_mtu }}"
        # Per-plane VXLAN VNI and bridge gateway, from the 5G network plan in all.yml
{% for plane in ['n1', 'n2', 'n3', 'n4', 'n6e', 'n6c', 'n6m'] %}
        - name: {{ plane | upper }}_VNI
          value: "{{ lookup('vars', plane ~ '_vni') }}"
        - name: {{ plane | upper }}_GATEWAY_CIDR
          value: "{{ lookup('vars', plane ~ '_gateway') }}/{{ lookup('vars', plane ~ '_subnet').split('/')[1] }}"
{% endfor %}
        command: ["sh","-c"]
        args:
          - |
            set -e
            apk add --no-cache bash iproute2 openvswitch iptables nftables util-linux coreutils

            # 1) Prepara host systemd-networkd (ignorare OVS)
            cp /scripts/host-networkd-prepare.sh /usr/local/bin/host-networkd-prepare.sh
            chmod +x /usr/local/bin/host-networkd-prepare.sh
            /usr/local/bin/host-networkd-prepare.sh

            # 2) Create OVS bridge/tunnel
            cp /scripts/ovs-setup.sh /usr/local/bin/ovs-setup.sh
            chmod +x /usr/local/bin/ovs-setup.sh
            /usr/local/bin/ovs-setup.sh

            # 3) Plane filter counters for Prometheus (worker owns the filter)
            if [ "$NODE_NAME" = "worker" ]; then
              cp /scripts/plane-metrics.sh /usr/local/bin/plane-metrics.sh
              chmod +x /usr/local/bin/plane-metrics.sh
              /usr/local/bin/plane-metrics.sh &
            fi

            # 4) (optional) GC and sleep
            if [ -f /scripts/ovs-gc.sh ]; then
              cp /scripts/ovs-gc.sh /usr/local/bin/ovs-gc.sh
              chmod +x /usr/local/bin/ovs-gc.sh
              /usr/local/bin/ovs-gc.sh &
            fi
            sleep infinity
        volumeMounts:
        - name: host-ovs-run
          mountPath: /var/run/openvswitch
        - name: host-ovs-etc
          mountPath: /etc/openvswitch
        - name: host-systemd-network
          mountPath: /host/etc/systemd/network
        - name: ovs-scripts
          mountPath: /scripts
        - name: node-metrics
          mountPath: /node-metrics
