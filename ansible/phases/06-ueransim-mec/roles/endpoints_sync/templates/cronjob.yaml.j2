apiVersion: batch/v1
kind: CronJob
metadata:
  name: gnb-endpoints-sync
  namespace: {{ namespace_5g }}
spec:
  schedule: "{{ sync_schedule }}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: {{ cronjob_successful_jobs_history_limit }}
  failedJobsHistoryLimit: {{ cronjob_failed_jobs_history_limit }}
  jobTemplate:
    spec:
      ttlSecondsAfterFinished: {{ cronjob_ttl_seconds_after_finished }}
      template:
        spec:
          serviceAccountName: {{ service_account_name }}
          restartPolicy: OnFailure
          containers:
            - name: sync
              image: python:3.11-alpine
              command: ["/bin/sh", "-c"]
              args:
                - |
                  pip install --no-cache-dir kubernetes && \
                  python /scripts/sync_endpoints.py
              volumeMounts:
                - name: scripts
                  mountPath: /scripts
          volumes:
            - name: scripts
              configMap:
                name: endpoints-sync-scripts


